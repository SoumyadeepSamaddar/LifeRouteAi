package com.liferoute.backend.repository;

import java.util.List;
import java.util.Optional;

import org.springframework.data.jpa.repository.JpaRepository;
import org.springframework.stereotype.Repository;

import com.liferoute.backend.entity.User;
import com.liferoute.domain.enums.Role;

@Repository
public interface UserRepository extends JpaRepository<User, Long> {
	Optional<User> findByEmailIgnoreCase(String email);
    List<User> findByRole(Role role);
    List<User> findByHospitalId(Long hospitalId);
    long countByRoleAndActiveTrue(Role role);
    List<User> findByHospitalIdOrderByCreatedAtDesc(Long hospitalId);
}
